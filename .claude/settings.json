{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__meta-ads__ads_get_*",
      "mcp__meta-ads__ads_insights_*",
      "mcp__meta-ads__ads_library_search",
      "mcp__meta-ads__ads_pixel_event_read",
      "mcp__meta-ads__ads_pixel_parameter_read",
      "mcp__meta-ads__ads_experiment_list_tests",
      "mcp__meta-ads__ads_experiment_check_eligibility",
      "mcp__meta-ads__ads_experiment_abtest_get_test",
      "mcp__meta-ads__ads_experiment_lift_get_test",
      "mcp__meta-ads__ads_account_get_activity_logs",
      "mcp__meta-ads__ads_catalog_get_*",
      "mcp__meta-ads__ads_catalog_list_*",
      "mcp__meta-ads__ads_catalog_search_product",
      "mcp__meta-ads__ads_catalog_event_source_get*",
      "mcp__ghl__search_operations",
      "mcp__ghl__describe_operation",
      "mcp__ghl__list_locations",
      "mcp__ghl__search",
      "mcp__ghl__fetch",
      "mcp__stripe__stripe_api_read",
      "mcp__stripe__stripe_api_search",
      "mcp__stripe__stripe_api_details",
      "mcp__stripe__get_stripe_account_info",
      "mcp__stripe__get_balance_summary",
      "mcp__stripe__search_stripe_documentation",
      "mcp__stripe__stripe_analytics",
      "mcp__stripe__search_stripe_resources",
      "mcp__stripe__fetch_stripe_resources",
      "mcp__stripe__retrieve_balance",
      "mcp__stripe__list_*",
